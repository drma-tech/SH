@page "/{culture}/account"
@inherits PageCore<AccountPage>

@inject ProfileApi ProfileApi

<PageSectionComponent Title="My profile">
    <ActionsFragment>
        <MudButton StartIcon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Color="Color.Primary" Href="@($"/{Culture}/account/edit")">
            @Translations.Button.Edit
        </MudButton>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl T="ProfileModel" State="ActionsProfile" Context="profile">
            <div>
                <CustomChip Name="Name" Value="@($"{profile.FirstName} {profile.LastName}")" Class="me-2"></CustomChip>
                <CustomChip Name="Nationality" Value="@profile.Nationality?.GetFieldSettings().Name" Class="me-2"></CustomChip>
                <CustomChip Name="Languages" Value="@string.Join(", ", profile.Languages.Select(l => l.GetFieldSettings().Name))" Class="me-2"></CustomChip>
                <CustomChip Name="Gender" Value="@profile.Gender?.GetFieldSettings().Name" Class="me-2"></CustomChip>
                <CustomChip Name="Home Schedule" Value="@profile.HomeSchedule?.GetFieldSettings().Name" Class="me-2"></CustomChip>
                <CustomChip Name="Occupation" Value="@profile.Occupation?.GetFieldSettings().Name" Class="me-2"></CustomChip>

            </div>
            <div>
                <CustomChip Name="ID Verified" Value="@profile.IdVerified" Class="me-2"></CustomChip>
                <CustomChip Name="Email Verified" Value="@profile.EmailVerified" Class="me-2"></CustomChip>
                <CustomChip Name="Phone Verified" Value="@profile.PhoneVerified" Class="me-2"></CustomChip>
            </div>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Host Ads" Subtitle="Create and manage ads for rooms you want to rent out.">
    <ActionsFragment>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Href="@($"/{Culture}/property/add/{Guid.NewGuid()}")">
            @Translations.Button.Add
        </MudButton>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl T="ProfileModel" State="ActionsProfile" Context="profile" LoadingHeight="275px">
            <Slider List="@profile.Properties" Context="property">
                <div style="@($"width: {(AppStateStatic.IsMobile ? "200" : "250")}px;")">
                    <div style="position: relative;">
                        <MudCard Outlined="true">
                            <MudCardMedia Image="@(property.PhotoUrl ?? "images/no-image.webp")" Height="150" />
                            <MudCardHeader Style="text-align: initial;" Class="pa-2">
                                <CardHeaderContent>
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">@property?.Title</MudText>
                                    <MudText Typo="Typo.body2">@($"{0} rooms available")</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardActions Style="align-self: center;">
                                <MudTooltip Text="Update">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="AppStateStatic.Size" Variant="Variant.Filled" Class="me-2" Color="Color.Primary"
                                                   Href="@($"/{Culture}/property/update/{property.PropertyId}")" />
                                </MudTooltip>
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="AppStateStatic.Size" Variant="Variant.Filled" Class="me-2" Color="Color.Error"
                                                   OnClick="@(() => Delete(property))" />
                                </MudTooltip>
                                <MudToggleIconButton Toggled="property.IsPublic" ToggledChanged="@(value => property.IsPublic ? Private(property) : Public(property))"
                                                     Icon="@Icons.Material.Filled.Cancel" Color="@Color.Error"
                                                     ToggledIcon="@Icons.Material.Filled.CheckCircle" ToggledColor="@Color.Success" />
                                <span>@(property.IsPublic ? "Public" : "Private")</span>
                            </MudCardActions>
                        </MudCard>
                    </div>
                </div>
            </Slider>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Guest Ads" Subtitle="Create and manage ads to find a room that matches your needs.">
    <ActionsFragment>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Disabled Href="@($"/{Culture}/account/ads/guest")">
            @Translations.Button.Add
        </MudButton>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl T="ProfileModel" State="ActionsProfile" LoadingHeight="275px">
            <Slider List="@context.Guests" Context="guest">
                <span></span>
            </Slider>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

@code {
    private RenderControlState<ProfileModel?> ActionsProfile { get; set; } = new RenderControlState<ProfileModel?>(null, obj => obj == null);
    private ProfileModel? profile;

    protected override async Task LoadStaticDataAsync()
    {
        profile = await ProfileApi.Get([ActionsProfile], true, Cts.Token);
    }

    private async Task Delete(ProfileProperty property)
    {
        if (await DialogService.ConfirmDelete())
        {
            profile = await ProfileApi.DeleteProperty(property.PropertyId, Cts.Token);
            await ActionsProfile.FinishLoading.Invoke(profile);
        }
    }

    private async Task Public(ProfileProperty property)
    {
        profile = await ProfileApi.PropertyPublic(property.PropertyId!, [ActionsProfile], Cts.Token);
        await ShowSuccess("Your property is now public and can be made available to our clients.");
    }

    private async Task Private(ProfileProperty property)
    {
        profile = await ProfileApi.PropertyPrivate(property.PropertyId!, [ActionsProfile], Cts.Token);
        await ShowInfo("Your property is now in private mode and will not be seen or shared with anyone.");
    }
}
