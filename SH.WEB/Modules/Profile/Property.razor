@page "/{culture}/property/new/{propertyId}"
@page "/{culture}/property/edit/{propertyId}"

@using SH.WEB.Modules.Auth.Core
@using SH.WEB.Modules.Profile.Core
@using SH.Shared.Requests
@inherits PageCore<Property>

@inject PrincipalApi PrincipalApi
@inject MapApi MapApi

<HeadComponent Title="Property" Url="@(new Uri(Navigation.Uri).PathAndQuery)" Index="false"></HeadComponent>

<PageSectionComponent Title="Address">
    <BodyFragment>
        <MudStack Spacing="3" Breakpoint="Breakpoint.Xs" Row="true">
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="12" sm="6">
                    <FieldText For="@(() => searchAddress)" @bind-Value="@searchAddress" ButtomClicked="SearchClick" ButtomCssIcon="@Icons.Material.Filled.Search"></FieldText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FieldText For="@(() => property.Address.Label)" @bind-Value="@property.Address.Label" Disabled="true"></FieldText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <FieldText For="@(() => property.Address.CountryName)" @bind-Value="@property.Address.CountryName" Disabled="true"></FieldText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <FieldText For="@(() => property.Address.State)" @bind-Value="@property.Address.State" Disabled="true"></FieldText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <FieldText For="@(() => property.Address.City)" @bind-Value="@property.Address.City" Disabled="true"></FieldText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <FieldText For="@(() => property.Address.District)" @bind-Value="@property.Address.District" Disabled="true"></FieldText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <FieldText For="@(() => property.Address.Street)" @bind-Value="@property.Address.Street" Disabled="true"></FieldText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <FieldText For="@(() => property.Address.PostalCode)" @bind-Value="@property.Address.PostalCode"></FieldText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <FieldText For="@(() => property.Address.HouseNumber)" @bind-Value="@property.Address.HouseNumber"></FieldText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <FieldText For="@(() => property.Address.Unit)" @bind-Value="@property.Address.Unit"></FieldText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <FieldSwitch For="@(() => property.Address.HideExactAddress)" @bind-Value="@property.Address.HideExactAddress"></FieldSwitch>
                </MudItem>
            </MudGrid>
        </MudStack>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Basic Data">
    <BodyFragment>
        <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
                        <MudGrid Spacing="@Css.SpaceSmall">
                            <MudItem xs="12">
                                <FieldGroup For="@(() => property.Structure)" TEnum="PropertyStructure" @bind-SelectedValue="property.Structure"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldGroup For="@(() => property.LivingArrangement)" TEnum="LivingArrangement" @bind-SelectedValue="property.LivingArrangement"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldText For="@(() => property.Title)" @bind-Value="@property.Title"></FieldText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <FieldNumber For="@(() => property.SizeSqm)" @bind-Value="@property.SizeSqm"></FieldNumber>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <FieldSelect For="@(() => property.Languages)" TEnum="Language" TValue="HashSet<Language>" Order="@((p) => p.Name)"
                                             @bind-SelectedValues="@property.Languages" Multiple="true" ShowDataSelectDescription="false"></FieldSelect>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
                        <MudGrid Spacing="@Css.SpaceSmall">
                            <MudItem xs="12">
                                <MudTabs>
                                    <MudTabPanel Text="Description">
                                        <FieldText For="@(() => property.Description)" Rows="10" @bind-Value="@property.Description" ShowLabel="false"></FieldText>
                                    </MudTabPanel>
                                    <MudTabPanel Text="Location Description">
                                        <FieldText For="@(() => property.LocationDesc)" Rows="10" @bind-Value="@property.LocationDesc" ShowLabel="false"></FieldText>
                                    </MudTabPanel>
                                    <MudTabPanel Text="CheckIn Instructions">
                                        <FieldText For="@(() => property.CheckInInstructions)" Rows="10" @bind-Value="@property.CheckInInstructions" ShowLabel="false"></FieldText>
                                    </MudTabPanel>
                                </MudTabs>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudStack>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Facilities" Subtitle="Shared by all tenants of the property (house) or building (apartment)" Description="Facilities are the essential physical spaces, infrastructure, and equipment that allow a location to function">
    <ActionsFragment>
        <MudToolBar Gutters="false" WrapContent="true">
            <FieldSelect For="@(() => PropertyFacility)" TEnum="PropertyFacility" TValue="PropertyFacility?" @bind-SelectedValue="@PropertyFacility" Style="width: 200px;"
                         Filter="@((p)=>property.Facilities.All(f => f.Facility != p.Value))"></FieldSelect>
            <FieldText For="@(() => PropertyFacilityCustomName)" @bind-Value="@PropertyFacilityCustomName" Class="ms-2" Style="width: 200px;"
                       Disabled="@(PropertyFacility != SH.Shared.Models.PropertyFacility.Custom)"></FieldText>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ms-2" OnClick="AddFacility"
                       Disabled="@(!PropertyFacility.HasValue)">
                @Translations.Button.Add
            </MudButton>
        </MudToolBar>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl Actions="ActionsFacilities">
            @foreach (var item in property.Facilities)
            {
                @if (item.Facility == SH.Shared.Models.PropertyFacility.Custom)
                {
                    <MudChip T="string" OnClose="() => RemoveFacility(item)" Color="Color.Primary">@item.CustomName</MudChip>
                }
                else
                {
                    <MudChip T="string" OnClose="() => RemoveFacility(item)" Color="Color.Primary">@item.Facility.GetName()</MudChip>
                }
            }
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Amenities" Subtitle="Shared by all tenants of the property (house) or building (apartment)" Description="Amenities are the added extras and services designed to provide comfort, convenience, or pleasure">
    <ActionsFragment>
        <MudToolBar Gutters="false" WrapContent="true">
            <FieldSelect For="@(() => PropertyAmenity)" TEnum="PropertyAmenity" TValue="PropertyAmenity?" @bind-SelectedValue="@PropertyAmenity" Style="width: 200px;"
                         Filter="@((p)=>property.Amenities.All(a => a.Amenity != p.Value))"></FieldSelect>
            <FieldText For="@(() => PropertyAmenityCustomName)" @bind-Value="@PropertyAmenityCustomName" Class="ms-2" Style="width: 200px;"
                       Disabled="@(PropertyAmenity != SH.Shared.Models.PropertyAmenity.Custom)"></FieldText>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ms-2" OnClick="AddAmenity"
                       Disabled="@(!PropertyAmenity.HasValue)">
                @Translations.Button.Add
            </MudButton>
        </MudToolBar>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl Actions="ActionsAmenities">
            @foreach (var item in property.Amenities)
            {
                @if (item.Amenity == SH.Shared.Models.PropertyAmenity.Custom)
                {
                    <MudChip T="string" OnClose="() => RemoveAmenity(item)" Color="Color.Primary">@item.CustomName</MudChip>
                }
                else
                {
                    <MudChip T="string" OnClose="() => RemoveAmenity(item)" Color="Color.Primary">@item.Amenity.GetName()</MudChip>
                }
            }
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Accessibilities">
    <ActionsFragment>
        <MudToolBar Gutters="false" WrapContent="true">
            <FieldSelect For="@(() => PropertyAccessibility)" TEnum="AccessibilityFeature" TValue="AccessibilityFeature?" @bind-SelectedValue="@PropertyAccessibility" Style="width: 250px;"
                         Filter="@((p)=>property.Accessibilities.All(a => a != p.Value))"></FieldSelect>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ms-2" OnClick="AddAccessibility"
                       Disabled="@(!PropertyAccessibility.HasValue)">
                @Translations.Button.Add
            </MudButton>
        </MudToolBar>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl Actions="ActionsAccessibilities">
            @foreach (var item in property.Accessibilities)
            {
                <MudChip T="string" OnClose="() => RemoveAccessibility(item)" Color="Color.Primary">@item.GetName()</MudChip>
            }
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

