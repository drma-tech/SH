@page "/{culture}/property/add/{propertyId}"
@page "/{culture}/property/update/{propertyId}"

@using FluentValidation
@using MudBlazor.Utilities
@using SH.Shared.Models.Property
@using SH.Shared.Models.Property.Core
@using SH.Shared.Requests
@using SH.WEB.Modules.Auth.Core
@using SH.WEB.Modules.Profile.Core
@using TranslationProperty = SH.Shared.Translations.Model.Property;
@inherits PageParameterCore<Property>

@inject PrincipalApi PrincipalApi
@inject MapApi MapApi
@inject PropertyApi PropertyApi
@inject RoomApi RoomApi

<HeadComponent Title="@Translations.Title.Property" Url="@(new Uri(Navigation.Uri).PathAndQuery)" Index="false"></HeadComponent>

<CustomNavigationLock IsDirty="IsDirty"></CustomNavigationLock>

<RenderControl Actions="ActionsProperty" Context="property">
    <MudForm @ref="_form" FieldChanged="OnFieldChanged">
        <PageSectionComponent Title="@TranslationProperty.Address">
            <BodyFragment>
                <MudStack Spacing="3" Breakpoint="Breakpoint.Xs" Row="true">
                    <MudGrid Spacing="@Css.SpaceSmall">
                        <MudItem xs="12" sm="6">
                            <FieldText @bind-Value="@searchAddress" ButtomClicked="SearchClick" ButtomCssIcon="@Icons.Material.Filled.Search"
                                       Name="@TranslationProperty.SearchAddress" Placeholder="@TranslationProperty.SearchAddressPlaceholder"
                                       Description="@TranslationProperty.SearchAddressDescription"></FieldText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <FieldText Name="@TranslationProperty.Label" Description="@TranslationProperty.LabelDescription" @bind-Value="@property.Address.Label" Disabled="true"></FieldText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <FieldText Name="@TranslationProperty.CountryName" @bind-Value="@property.Address.CountryName" Disabled="true"></FieldText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <FieldText Name="@TranslationProperty.State" @bind-Value="@property.Address.State" Disabled="true"></FieldText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <FieldText Name="@TranslationProperty.City" @bind-Value="@property.Address.City" Disabled="true"></FieldText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <FieldText Name="@TranslationProperty.District" @bind-Value="@property.Address.District" Disabled="true"></FieldText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <FieldText Name="@TranslationProperty.Street" @bind-Value="@property.Address.Street" Disabled="true"></FieldText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <FieldText Name="@TranslationProperty.PostalCode" @bind-Value="@property.Address.PostalCode"></FieldText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <FieldText Name="@TranslationProperty.HouseNumber" @bind-Value="@property.Address.HouseNumber"></FieldText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <FieldText Name="@TranslationProperty.Unit" @bind-Value="@property.Address.Unit"></FieldText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <FieldSwitch Name="@TranslationProperty.HideExactAddress" @bind-Value="@property.Address.HideExactAddress"></FieldSwitch>
                        </MudItem>
                    </MudGrid>
                </MudStack>
            </BodyFragment>
        </PageSectionComponent>

        <PageSectionComponent Title="@TranslationProperty.BasicData">
            <BodyFragment>
                <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
                    <MudGrid Spacing="@Css.SpaceSmall">
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
                                <MudGrid Spacing="@Css.SpaceSmall">
                                    <MudItem xs="12">
                                        <FieldGroup Name="@TranslationProperty.Structure" TEnum="PropertyStructure" @bind-SelectedValue="property.Structure" MudForm="_form"></FieldGroup>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <FieldGroup Name="@TranslationProperty.SharedWith" TEnum="SharedWith" @bind-SelectedValue="property.SharedWith" MudForm="_form"></FieldGroup>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <FieldText Name="@TranslationProperty.Title" Placeholder="@TranslationProperty.TitlePlaceholder" @bind-Value="@property.Title"></FieldText>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <FieldNumber Name="@TranslationProperty.SizeSqm" @bind-Value="@property.SizeSqm"></FieldNumber>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <FieldSelect Name="@TranslationProperty.Languages" TEnum="Language" TValue="HashSet<Language>" Order="@((p) => p.Name)"
                                                     @bind-SelectedValues="@property.Languages" Multiple="true" ShowDataSelectDescription="false"></FieldSelect>
                                    </MudItem>
                                </MudGrid>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
                                <MudGrid Spacing="@Css.SpaceSmall">
                                    <MudItem xs="12">
                                        <MudTabs>
                                            <MudTabPanel Text="@TranslationProperty.Description">
                                                <FieldText Placeholder="@TranslationProperty.DescriptionPlaceholder" Rows="10" @bind-Value="@property.Description"></FieldText>
                                            </MudTabPanel>
                                            <MudTabPanel Text="@TranslationProperty.LocationDesc">
                                                <FieldText Placeholder="@TranslationProperty.LocationDescPlaceholder" Rows="10" @bind-Value="@property.LocationDesc"></FieldText>
                                            </MudTabPanel>
                                            <MudTabPanel Text="@TranslationProperty.CheckInInstructions">
                                                <FieldText Placeholder="@TranslationProperty.CheckInInstructionsPlaceholder" Rows="10" @bind-Value="@property.CheckInInstructions"></FieldText>
                                            </MudTabPanel>
                                        </MudTabs>
                                    </MudItem>
                                </MudGrid>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudStack>
            </BodyFragment>
        </PageSectionComponent>

        <PageSectionComponent Title="@TranslationProperty.Facilities" Subtitle="@TranslationProperty.FacilitiesSubtitle" Description="@TranslationProperty.FeatureDescription">
            <ActionsFragment>
                <MudToolBar Gutters="false" WrapContent="true">
                    <FieldSelect Name="@TranslationProperty.Facility" TEnum="PropertyFacility" TValue="PropertyFacility?" @bind-SelectedValue="@PropertyFacility" Style="width: 200px;"
                                 Filter="@((p) => property.Facilities.All(f => f.Facility != p.Value || f.Facility== SH.Shared.Enums.PropertyFacility.Custom))"></FieldSelect>
                    <FieldText Name="@TranslationProperty.Name" @bind-Value="@PropertyFacilityCustomName" CssClass="ms-2" Style="width: 200px;"
                               Visible="@(PropertyFacility == SH.Shared.Enums.PropertyFacility.Custom)"></FieldText>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ms-2" OnClick="AddFacility"
                               Disabled="@(!PropertyFacility.HasValue)">
                        @Translations.Button.Add
                    </MudButton>
                </MudToolBar>
            </ActionsFragment>
            <BodyFragment>
                <RenderControl Actions="ActionsFacilities">
                    @foreach (var item in property.Facilities)
                    {
                        @if (item.Facility == SH.Shared.Enums.PropertyFacility.Custom)
                        {
                            <MudChip T="string" OnClose="() => RemoveFacility(item)" Color="Color.Primary">
                                @item.CustomName
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" OnClose="() => RemoveFacility(item)" Color="Color.Primary">
                                @item.Facility.GetFieldSettings().Name
                            </MudChip>
                        }
                    }
                </RenderControl>
            </BodyFragment>
        </PageSectionComponent>

        <PageSectionComponent Title="@TranslationProperty.Amenities" Subtitle="@TranslationProperty.AmenitiesSubtitle" Description="@TranslationProperty.FeatureDescription">
            <ActionsFragment>
                <MudToolBar Gutters="false" WrapContent="true">
                    <FieldSelect Name="@TranslationProperty.Amenity" TEnum="PropertyAmenity" TValue="PropertyAmenity?" @bind-SelectedValue="@PropertyAmenity" Style="width: 200px;"
                                 Filter="@((p) => property.Amenities.All(a => a.Amenity != p.Value|| a.Amenity == SH.Shared.Enums.PropertyAmenity.Custom))"></FieldSelect>
                    <FieldText Name="@TranslationProperty.Name" @bind-Value="@PropertyAmenityCustomName" CssClass="ms-2" Style="width: 200px;"
                               Visible="@(PropertyAmenity == SH.Shared.Enums.PropertyAmenity.Custom)"></FieldText>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ms-2" OnClick="AddAmenity"
                               Disabled="@(!PropertyAmenity.HasValue)">
                        @Translations.Button.Add
                    </MudButton>
                </MudToolBar>
            </ActionsFragment>
            <BodyFragment>
                <RenderControl Actions="ActionsAmenities">
                    @foreach (var item in property.Amenities)
                    {
                        @if (item.Amenity == SH.Shared.Enums.PropertyAmenity.Custom)
                        {
                            <MudChip T="string" OnClose="() => RemoveAmenity(item)" Color="Color.Primary">@item.CustomName</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" OnClose="() => RemoveAmenity(item)" Color="Color.Primary">@item.Amenity.GetFieldSettings().Name</MudChip>
                        }
                    }
                </RenderControl>
            </BodyFragment>
        </PageSectionComponent>

        <PageSectionComponent Title="@TranslationProperty.Accessibilities">
            <ActionsFragment>
                <MudToolBar Gutters="false" WrapContent="true">
                    <FieldSelect Name="@TranslationProperty.Accessibility" TEnum="AccessibilityFeature" TValue="AccessibilityFeature?" @bind-SelectedValue="@PropertyAccessibility" Style="width: 250px;"
                                 Filter="@((p) => property.Accessibilities.All(a => a != p.Value))"></FieldSelect>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ms-2" OnClick="AddAccessibility"
                               Disabled="@(!PropertyAccessibility.HasValue)">
                        @Translations.Button.Add
                    </MudButton>
                </MudToolBar>
            </ActionsFragment>
            <BodyFragment>
                <RenderControl Actions="ActionsAccessibilities">
                    @foreach (var item in property.Accessibilities)
                    {
                        <MudChip T="string" OnClose="() => RemoveAccessibility(item)" Color="Color.Primary">@item.GetFieldSettings().Name</MudChip>
                    }
                </RenderControl>
            </BodyFragment>
        </PageSectionComponent>

        <PageSectionComponent Title="@TranslationProperty.Requirements" Description="@TranslationProperty.RequirementsDescription">
            <BodyFragment>
                <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
                    <MudGrid Spacing="@Css.SpaceSmall">
                        <MudItem xs="12" sm="6">
                            <FieldSwitch Name="@TranslationProperty.SocialRequired" Description="@TranslationProperty.SocialRequiredDescription" @bind-Value="@property.SocialRequired"></FieldSwitch>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <FieldSwitch Name="@TranslationProperty.IdVerificationRequired" Description="@TranslationProperty.IdVerificationRequiredDescription" @bind-Value="@property.IdVerificationRequired"></FieldSwitch>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <FieldSwitch Name="@TranslationProperty.IncomeVerificationRequired" Description="@TranslationProperty.IncomeVerificationRequiredDescription" @bind-Value="@property.IncomeVerificationRequired" Disabled="true"></FieldSwitch>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <FieldSwitch Name="@TranslationProperty.BackgroundCheckRequired" Description="@TranslationProperty.BackgroundCheckRequiredDescription" @bind-Value="@property.BackgroundCheckRequired" Disabled="true"></FieldSwitch>
                        </MudItem>
                    </MudGrid>
                </MudStack>
            </BodyFragment>
        </PageSectionComponent>

        <PageSectionComponent Title="@TranslationProperty.Photos">
            <ActionsFragment>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Disabled OnClick="@(() => SelectPicture())">
                    @Translations.Button.Add
                </MudButton>
            </ActionsFragment>
            <BodyFragment>
                <Slider List="property.Photos" Context="item">
                    <div style="@($"height: {(AppStateStatic.IsMobile ? "150" : "200")}px;")">
                        <MudImage Src="@item.UrlPath" Alt="@item.Caption" FallbackSrc="@ImageHelper.GetDefaultPhoto"
                                  ObjectFit="ObjectFit.Cover" ObjectPosition="ObjectPosition.Center" Style="height: 100%;"></MudImage>
                        <div class="carousel-caption">
                            <MudText Typo="Typo.caption" Inline="false">
                                @item.Caption.Truncate(40)
                            </MudText>
                        </div>
                    </div>
                </Slider>
            </BodyFragment>
        </PageSectionComponent>

        <PageSectionComponent Title="@TranslationProperty.Rooms">
            <ActionsFragment>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo($"/{Culture}/room/add/{propertyId}/{Guid.NewGuid()}"))">
                    @Translations.Button.Add
                </MudButton>
            </ActionsFragment>
            <BodyFragment>
                <Slider List="@property.Rooms" Context="room">
                    <div style="@($"width: {(AppStateStatic.IsMobile ? "200" : "250")}px;")">
                        <div style="position: relative;">
                            <MudCard Outlined="true">
                                <MudCardMedia Image="@(room.UrlPath ?? "images/no-image.webp")" Height="150" />
                                <MudCardHeader Style="text-align: initial;" Class="pa-2">
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.body1" Color="Color.Secondary">@room?.Title</MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardActions Style="align-self: center;">
                                    <MudTooltip Text="Update">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="AppStateStatic.Size" Variant="Variant.Filled" Class="me-2" Color="Color.Primary"
                                                       OnClick="@(() => Navigation.NavigateTo($"/{Culture}/room/update/{propertyId}/{room.RoomId}"))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Delete">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="AppStateStatic.Size" Variant="Variant.Filled" Color="Color.Error"
                                                       OnClick="@(() => Delete(room))" />
                                    </MudTooltip>
                                </MudCardActions>
                            </MudCard>
                        </div>
                    </div>
                </Slider>
            </BodyFragment>
        </PageSectionComponent>
    </MudForm>
</RenderControl>

<FloatingButton StartIcon="@Icons.Material.Filled.Save" OnClick="SaveHandle" Position="2" Disabled="!IsDirty"></FloatingButton>

<FloatingButton Template="Template.Back"></FloatingButton>

@code
{
    [Parameter] public string? propertyId { get; set; }

    private ComponentActions<PropertyModel> ActionsProperty { get; set; } = new ComponentActions<PropertyModel>(obj => obj == null);
    private PropertyModel? model;

    private ComponentActions<HashSet<PropertyFacilityModel>> ActionsFacilities { get; set; } = new ComponentActions<HashSet<PropertyFacilityModel>>(p => p == null || p.Empty());
    private ComponentActions<HashSet<PropertyAmenityModel>> ActionsAmenities { get; set; } = new ComponentActions<HashSet<PropertyAmenityModel>>(p => p == null || p.Empty());
    private ComponentActions<HashSet<AccessibilityFeature>> ActionsAccessibilities { get; set; } = new ComponentActions<HashSet<AccessibilityFeature>>(p => p == null || p.Empty());

    private string? searchAddress { get; set; }

    public PropertyFacility? PropertyFacility { get; set; }
    public string? PropertyFacilityCustomName { get; set; }
    public PropertyAmenity? PropertyAmenity { get; set; }
    public string? PropertyAmenityCustomName { get; set; }
    public AccessibilityFeature? PropertyAccessibility { get; set; }

    private HereJson? here;

    private MudForm? _form;
    private bool IsDirty { get; set; } = false;

    private void OnFieldChanged(FormFieldChangedEventArgs args)
    {
        IsDirty = true;
    }

    protected override IReadOnlyList<string?> GetParameterKey()
    {
        return [ propertyId ];
    }

    protected override async Task LoadParameterDataAsync()
    {
        if (Navigation.Uri.Contains("/add/"))
        {
            model ??= new(propertyId);
            model.Members.Add(new PropertyMember { UserId = AppStateStatic.UserId, Role = PropertyUserRole.Owner });

            await ActionsProperty.FinishLoading.Invoke(model);
        }
        else
        {
            model = await PropertyApi.Get(false, propertyId, ActionsProperty, cts.Token) ?? throw new NotificationException("property not found");
        }

        await ActionsFacilities.FinishLoading.Invoke(model.Facilities);
        await ActionsAmenities.FinishLoading.Invoke(model.Amenities);
        await ActionsAccessibilities.FinishLoading.Invoke(model.Accessibilities);
    }

    private async Task SearchClick()
    {
        here = await MapApi.HereGeocode(searchAddress, cts.Token);
        var first = here?.items.FirstOrDefault();

        model!.Address = new PropertyAddress
        {
            Latitude = first?.position?.lat ?? 0,
            Longitude = first?.position?.lng ?? 0,
            Label = first?.address?.label,
            CountryCode = first?.address?.countryCode,
            CountryName = first?.address?.GetCountry(),
            State = first?.address?.GetState(),
            City = first?.address?.GetCity(),
            District = first?.address?.district,
            Street = first?.address?.street,
            PostalCode = first?.address?.postalCode,
            HouseNumber = first?.address?.houseNumber
        };

        var country = first?.address?.countryCode.ParseToEnum<CountryExtended>();
        model.Languages = DataHelper.GetLanguages((Country?)country).ToHashSet();
    }

    private async Task AddFacility()
    {
        if (PropertyFacility.HasValue)
        {
            model!.Facilities.Add(new PropertyFacilityModel { Facility = PropertyFacility.Value, CustomName = PropertyFacilityCustomName });
            PropertyFacility = null;
            PropertyFacilityCustomName = null;
            await _form!.FieldChanged.InvokeAsync();
        }
    }

    private async Task RemoveFacility(PropertyFacilityModel item)
    {
        model!.Facilities.Remove(item);
        await _form!.FieldChanged.InvokeAsync();
    }

    private async Task AddAmenity()
    {
        if (PropertyAmenity.HasValue)
        {
            model!.Amenities.Add(new PropertyAmenityModel { Amenity = PropertyAmenity.Value, CustomName = PropertyAmenityCustomName });
            PropertyAmenity = null;
            PropertyAmenityCustomName = null;
            await _form!.FieldChanged.InvokeAsync();
        }
    }

    private async Task RemoveAmenity(PropertyAmenityModel item)
    {
        model!.Amenities.Remove(item);
        await _form!.FieldChanged.InvokeAsync();
    }

    private async Task AddAccessibility()
    {
        if (PropertyAccessibility.HasValue)
        {
            model!.Accessibilities.Add(PropertyAccessibility.Value);
            PropertyAccessibility = null;
            await _form!.FieldChanged.InvokeAsync();
        }
    }

    private async Task RemoveAccessibility(AccessibilityFeature item)
    {
        model!.Accessibilities.Remove(item);
        await _form!.FieldChanged.InvokeAsync();
    }

    private async Task SelectPicture()
    {
        await DialogService.SelectPicturePopup(new EventCallbackFactory().Create(this, async ((byte[], string?) result) => await PictureChanged(result.Item1, result.Item2)));
    }

    private async Task PictureChanged(byte[] buffer, string? caption)
    {
        try
        {
            var request = new PhotoRequest { Buffer = buffer };

            // _profile = await StorageApi.UploadPhoto(request, cts.Token);
            model!.Photos.Add(new PropertyPhoto { UrlPath = $"data:image/webp;base64,{buffer.ConvertFromBytesToBase64()}", Caption = caption });

            await _form!.FieldChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            await ProcessException(ex);
        }
    }

    private async Task SaveHandle()
    {
        if (model == null) throw new InvalidOperationException("property is null");

        try
        {
            model.SanitizeOpenTextFields();

            var validator = new PropertyValidation();
            var result = await validator.ValidateAsync(model, options => options.IncludeRuleSets("OFF"));

            if (result.IsValid)
            {
                await ActionsProperty.StartProcessing.Invoke(null);

                if (Navigation.Uri.Contains("/add/"))
                {
                    model = await PropertyApi.Add(model, cts.Token);
                }
                else
                {
                    model = await PropertyApi.Update(model, cts.Token);
                }

                await ActionsProperty.FinishProcessing.Invoke(model);

                IsDirty = false; StateHasChanged();

                await ShowSuccess(Translations.Notification.OperationCompleted);

                Navigation.NavigateTo($"/{Culture}/account");
            }
            else
            {
                var message = result.Errors[0].ErrorMessage;

                await ShowWarning(message);
            }
        }
        catch (Exception ex)
        {
            await ProcessException(ex);
        }
    }

    private async Task Delete(RoomShort room)
    {
        model = await RoomApi.Delete(false, model!.Identity.RawId, room.RoomId, cts.Token);
        await ActionsProperty.FinishLoading.Invoke(model);
    }
}
