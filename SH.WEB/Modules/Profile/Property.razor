<PageSectionComponent Title="Photos">
    <ActionsFragment>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SelectPicture())">
            @Translations.Button.Add
        </MudButton>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl Actions="ActionsPhotos">
            <Slider List="context" Context="item">
                <div style="@($"height: {(IsMobile ? "150" : "200")}px;")">
                    <MudImage Src="@item.UrlPath" Alt="@item.Caption" FallbackSrc="@ImageHelper.GetDefaultPhoto"
                              ObjectFit="ObjectFit.Cover" ObjectPosition="ObjectPosition.Center" Style="height: 100%;"></MudImage>
                    <div class="carousel-caption">
                        <MudText Typo="Typo.caption" Inline="false">
                            @item.Caption.Truncate(40)
                        </MudText>
                    </div>
                </div>
            </Slider>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Rooms">
    <ActionsFragment>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo($"/{Culture}/room/new/{propertyId}/{Guid.NewGuid()}"))">
            @Translations.Button.Add
        </MudButton>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl Actions="ActionsRooms">
            @foreach (var item in context)
            {

            }
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

@code
{
    [Parameter] public string? propertyId { get; set; }

    private PropertyModel property = new();
    private bool IsMobile => AppStateStatic.Breakpoint == Breakpoint.Xs;

    public ComponentActions<List<PropertyPhoto>> ActionsPhotos { get; set; } = new ComponentActions<List<PropertyPhoto>>(list => list == null || list.Empty());
    public ComponentActions<List<RoomShort>> ActionsRooms { get; set; } = new ComponentActions<List<RoomShort>>(list => list == null || list.Empty());

    public ComponentActions<List<PropertyFacilityModel>> ActionsFacilities { get; set; } = new ComponentActions<List<PropertyFacilityModel>>(list => list == null || list.Empty());
    public ComponentActions<List<PropertyAmenityModel>> ActionsAmenities { get; set; } = new ComponentActions<List<PropertyAmenityModel>>(list => list == null || list.Empty());
    public ComponentActions<List<AccessibilityFeature>> ActionsAccessibilities { get; set; } = new ComponentActions<List<AccessibilityFeature>>(list => list == null || list.Empty());

    [Custom(Name = "Search Address",
    Placeholder = "Type something to search for, such as an address, building name, etc.",
    Description = "For legal reasons, some regions may limit or deny detailed address searches. Please contact us for support.")]
    private string? searchAddress;

    [Custom(Name = "Facility")]
    public PropertyFacility? PropertyFacility { get; set; }

    [Custom(Name = "Name")]
    public string? PropertyFacilityCustomName { get; set; }

    [Custom(Name = "Amenity")]
    public PropertyAmenity? PropertyAmenity { get; set; }

    [Custom(Name = "Name")]
    public string? PropertyAmenityCustomName { get; set; }

    [Custom(Name = "Accessibility")]
    public AccessibilityFeature? PropertyAccessibility { get; set; }

    private HereJson? here;

    protected override async Task ProcessPageData()
    {
        await ActionsPhotos.FinishLoading.Invoke([]);
        await ActionsRooms.FinishLoading.Invoke([]);
        await ActionsFacilities.FinishLoading.Invoke([]);
        await ActionsAmenities.FinishLoading.Invoke([]);
        await ActionsAccessibilities.FinishLoading.Invoke([]);

        property.Members.Add(new PropertyMember { UserId = "John", Role = PropertyUserRole.Owner });
    }

    private async Task SearchClick()
    {
        here = await MapApi.HereGeocode(searchAddress, cts.Token);
        var first = here?.items.FirstOrDefault()?.address;

        property.Address = new PropertyAddress
        {
            Label = first?.label,
            CountryCode = first?.countryCode,
            CountryName = first?.GetCountry(),
            State = first?.GetState(),
            City = first?.GetCity(),
            District = first?.district,
            Street = first?.street,
            PostalCode = first?.postalCode,
            HouseNumber = first?.houseNumber
        };

        property.Languages = DataHelper.GetLanguages(Country.Brazil).ToHashSet();
    }

    private async Task AddFacility()
    {
        if (PropertyFacility.HasValue)
        {
            property.Facilities.Add(new PropertyFacilityModel { Facility = PropertyFacility.Value, CustomName = PropertyFacilityCustomName });
            PropertyFacility = null;
            PropertyFacilityCustomName = null;
        }

        await ActionsFacilities.FinishLoading.Invoke(property.Facilities);
    }

    private async Task RemoveFacility(PropertyFacilityModel item)
    {
        property.Facilities.Remove(item);
        await ActionsFacilities.FinishLoading.Invoke(property.Facilities);
    }

    private async Task AddAmenity()
    {
        if (PropertyAmenity.HasValue)
        {
            property.Amenities.Add(new PropertyAmenityModel { Amenity = PropertyAmenity.Value, CustomName = PropertyAmenityCustomName });
            PropertyAmenity = null;
            PropertyAmenityCustomName = null;
        }
        await ActionsAmenities.FinishLoading.Invoke(property.Amenities);
    }

    private async Task RemoveAmenity(PropertyAmenityModel item)
    {
        property.Amenities.Remove(item);
        await ActionsAmenities.FinishLoading.Invoke(property.Amenities);
    }

    private async Task AddAccessibility()
    {
        if (PropertyAccessibility.HasValue)
        {
            property.Accessibilities.Add(PropertyAccessibility.Value);
            PropertyAccessibility = null;
        }
        await ActionsAccessibilities.FinishLoading.Invoke(property.Accessibilities);
    }

    private async Task RemoveAccessibility(AccessibilityFeature item)
    {
        property.Accessibilities.Remove(item);
        await ActionsAccessibilities.FinishLoading.Invoke(property.Accessibilities);
    }

    private async Task SelectPicture()
    {
        await DialogService.SelectPicturePopup(new EventCallbackFactory().Create(this, async ((byte[], string?) result) => await PictureChanged(result.Item1, result.Item2)));
    }

    private async Task PictureChanged(byte[] buffer, string? caption)
    {
        try
        {
            var request = new PhotoRequest { Buffer = buffer };

            // _profile = await StorageApi.UploadPhoto(request, cts.Token);
            property.Photos.Add(new PropertyPhoto { UrlPath = $"data:image/webp;base64,{buffer.ConvertFromBytesToBase64()}", Caption = caption });

            await ActionsPhotos.FinishLoading.Invoke(property.Photos);
        }
        catch (Exception ex)
        {
            await ProcessException(ex);
        }
    }
}
