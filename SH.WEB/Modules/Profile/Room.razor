@page "/{culture}/room/new/{propertyId}/{roomId}"
@page "/{culture}/room/edit/{propertyId}/{roomId}"

@using SH.WEB.Modules.Auth.Core
@using SH.Shared.Requests
@inherits PageCore<Room>

@inject PrincipalApi PrincipalApi

<HeadComponent Title="@Translations.Title.Profile" Url="@(new Uri(Navigation.Uri).PathAndQuery)" Index="false"></HeadComponent>

<PageSectionComponent Title="Basic Data">
    <BodyFragment>
        <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
                        <MudGrid Spacing="@Css.SpaceSmall">
                            <MudItem xs="12">
                                <FieldGroup For="@(() => room.AccessType)" TEnum="AccessType" @bind-SelectedValue="room.AccessType"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldText For="@(() => room.Title)" @bind-Value="@room.Title"></FieldText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <FieldNumber For="@(() => room.SizeSqm)" @bind-Value="@room.SizeSqm"></FieldNumber>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
                        <MudGrid Spacing="@Css.SpaceSmall">
                            <MudItem xs="12">
                                <MudTabs>
                                    <MudTabPanel Text="Description">
                                        <FieldText For="@(() => room.Description)" Rows="10" @bind-Value="@room.Description" ShowLabel="false"></FieldText>
                                    </MudTabPanel>
                                </MudTabs>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudStack>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Facilities" Description="Physical spaces (private or shared among residents)">
    <ActionsFragment>
        <MudToolBar Gutters="false" WrapContent="true">
            <FieldSelect For="@(() => RoomFacility)" TEnum="RoomFacility" TValue="RoomFacility?" @bind-SelectedValue="@RoomFacility" Style="width: 200px;"
                         Filter="@((p)=>room.Facilities.All(f => f.Facility != p.Value))"></FieldSelect>
            <FieldGroup TEnum="AccessType" @bind-SelectedValue="RoomFacilityAccess" Class="ms-2" Style="width: 250px;"></FieldGroup>
            <FieldText For="@(() => RoomFacilityCustomName)" @bind-Value="@RoomFacilityCustomName" Class="ms-2" Style="width: 200px;"
                       Visible="@(RoomFacility == SH.Shared.Models.RoomFacility.Custom)"></FieldText>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ms-2" OnClick="AddFacility"
                       Disabled="@(!RoomFacility.HasValue)">
                @Translations.Button.Add
            </MudButton>
        </MudToolBar>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl Actions="ActionsFacilities">
            @foreach (var item in room.Facilities)
            {
                @if (item.Facility == SH.Shared.Models.RoomFacility.Custom)
                {
                    <MudChip T="string" OnClose="() => RemoveFacility(item)" Color="Color.Primary">
                        @($"{item.CustomName} ({item.AccessType.GetName()})")
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" OnClose="() => RemoveFacility(item)" Color="Color.Primary">
                        @($"{item.Facility.GetName()} ({item.AccessType.GetName()})")
                    </MudChip>
                }
            }
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Amenities" Description="Amenities are the added extras and services designed to provide comfort, convenience, or pleasure">
    <ActionsFragment>
        <MudToolBar Gutters="false" WrapContent="true">
            <FieldSelect For="@(() => RoomAmenity)" TEnum="RoomAmenity" TValue="RoomAmenity?" @bind-SelectedValue="@RoomAmenity" Style="width: 200px;"
                         Filter="@((p)=>room.Amenities.All(a => a.Amenity != p.Value))"></FieldSelect>
            <FieldText For="@(() => RoomAmenityCustomName)" @bind-Value="@RoomAmenityCustomName" Class="ms-2" Style="width: 200px;"
                       Visible="@(RoomAmenity == SH.Shared.Models.RoomAmenity.Custom)"></FieldText>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ms-2" OnClick="AddAmenity"
                       Disabled="@(!RoomAmenity.HasValue)">
                @Translations.Button.Add
            </MudButton>
        </MudToolBar>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl Actions="ActionsAmenities">
            @foreach (var item in room.Amenities)
            {
                @if (item.Amenity == SH.Shared.Models.RoomAmenity.Custom)
                {
                    <MudChip T="string" OnClose="() => RemoveAmenity(item)" Color="Color.Primary">
                        @item.CustomName
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" OnClose="() => RemoveAmenity(item)" Color="Color.Primary">
                        @item.Amenity.GetName()
                    </MudChip>
                }
            }
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Services" Description="Available services (included in the rent or paid separately)">
    <ActionsFragment>
        <MudToolBar Gutters="false" WrapContent="true">
            <FieldSelect For="@(() => RoomService)" TEnum="RoomService" TValue="RoomService?" @bind-SelectedValue="@RoomService" Style="width: 200px;"
                         Filter="@((p)=>room.Services.All(s => s.Service != p.Value))"></FieldSelect>
            <FieldGroup TEnum="RoomServicePrice" @bind-SelectedValue="RoomServicePrice" Class="ms-2" Style="width: 250px;"></FieldGroup>
            <FieldText For="@(() => RoomServiceCustomName)" @bind-Value="@RoomServiceCustomName" Class="ms-2" Style="width: 200px;"
                       Visible="@(RoomService == SH.Shared.Models.RoomService.Custom)"></FieldText>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ms-2" OnClick="AddService"
                       Disabled="@(!RoomService.HasValue)">
                @Translations.Button.Add
            </MudButton>
        </MudToolBar>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl Actions="ActionsServices">
            @foreach (var item in room.Services)
            {
                @if (item.Service == SH.Shared.Models.RoomService.Custom)
                {
                    <MudChip T="string" OnClose="() => RemoveService(item)" Color="Color.Primary">
                        @($"{item.CustomName} ({item.Price.GetName()})")
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" OnClose="() => RemoveService(item)" Color="Color.Primary">
                        @($"{item.Service.GetName()} ({item.Price.GetName()})")
                    </MudChip>
                }
            }
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Preferences">
    <BodyFragment>

        <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
                        <MudGrid Spacing="@Css.SpaceSmall">
                            <MudItem xs="12">
                                <FieldGroup For="@(() => room.Couples)" TEnum="Allowed" @bind-SelectedValue="room.Couples"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldGroup For="@(() => room.Children)" TEnum="Allowed" @bind-SelectedValue="room.Children"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldGroup For="@(() => room.Pets)" TEnum="Allowed" @bind-SelectedValue="room.Pets"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldGroup For="@(() => room.Visits)" TEnum="Allowed" @bind-SelectedValue="room.Visits"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldGroup For="@(() => room.Smoking)" TEnum="Allowed" @bind-SelectedValue="room.Smoking"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldGroup For="@(() => room.Alcohol)" TEnum="Allowed" @bind-SelectedValue="room.Alcohol"></FieldGroup>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
                        <MudGrid Spacing="@Css.SpaceSmall">
                            <MudItem xs="12">
                                <FieldGroup ForM="@(() => room.PreferredGenders)" TEnum="Gender" SelectedValues="room.PreferredGenders" Multiple="true"
                                            CustomInfo="Leave blank if you have no preferences." Vertical="IsMobile"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldGroup ForM="@(() => room.PreferredOccupations)" TEnum="Occupation" SelectedValues="room.PreferredOccupations" Multiple="true"
                                            CustomInfo="Leave blank if you have no preferences." Vertical="true"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldNumber T="int?" For="@(() => room.MinimumAge)" @bind-Value="@room.MinimumAge"></FieldNumber>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldNumber T="int?" For="@(() => room.MaximumAge)" @bind-Value="@room.MaximumAge"></FieldNumber>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudStack>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Rental Terms">
    <ExtraFragment>
        <MudToolBar Gutters="false" WrapContent="true">
            <FieldSelect For="@(() => room.Currency)" TEnum="Currency" TValue="Currency" @bind-SelectedValue="@room.Currency" Class="me-2" Style="width: 250px;"></FieldSelect>
            <FieldNumber T="int?" For="@(() => room.PeriodStay)" @bind-Value="@room.PeriodStay" Class="me-2" Style="width: 100px;"></FieldNumber>
            <FieldSelect For="@(() => room.IntervalStay)" TEnum="StayInterval" TValue="StayInterval" @bind-SelectedValue="@room.IntervalStay" Class="me-2" Style="width: 120px;"></FieldSelect>
            <FieldText For="@(() => room.MinimumStay)" Value="@room.MinimumStay" Class="me-2" Style="width: 130px;" Disabled="true"></FieldText>
        </MudToolBar>
    </ExtraFragment>
    <ActionsFragment>
        <MudToolBar Gutters="false" WrapContent="true">
            <FieldSelect For="@(() => PaymentType)" TEnum="PaymentType" TValue="PaymentType" @bind-SelectedValue="@PaymentType" Class="me-2" Style="width: 130px;"
                         Filter="@((p)=>room.Charges.All(s => s.Type != p.Value))"></FieldSelect>
            <FieldSelect For="@(() => Frequency)" TEnum="PaymentInterval" TValue="PaymentInterval" @bind-SelectedValue="@Frequency" Class="me-2" Style="width: 200px;"></FieldSelect>
            <FieldText For="@(() => ChargeCustomName)" @bind-Value="@ChargeCustomName" Class="me-2" Style="width: 130px;"
                       Visible="@(PaymentType == SH.Shared.Models.PaymentType.Custom)"></FieldText>
            <FieldNumber T="decimal?" For="@(() => ChargeAmount)" @bind-Value="@ChargeAmount" Class="me-2" Style="width: 100px;"></FieldNumber>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddCharge"
                       Disabled="@(!ChargeAmount.HasValue)">
                @Translations.Button.Add
            </MudButton>
        </MudToolBar>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl Actions="ActionsCharges">
            @foreach (var item in room.Charges)
            {
                @if (item.Type == SH.Shared.Models.PaymentType.Custom)
                {
                    <MudChip T="string" OnClose="() => RemoveCharge(item)" Color="Color.Primary">
                        @($"{item.CustomName} ({item.Frequency.GetName()}: {room.Currency.ToString()} {item.Amount:N2})")
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" OnClose="() => RemoveCharge(item)" Color="Color.Primary">
                        @($"{item.Type.GetName()} ({item.Frequency.GetName()}: {room.Currency.ToString()} {item.Amount:N2})")
                    </MudChip>
                }
            }
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Photos">
    <ActionsFragment>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SelectPicture())">
            @Translations.Button.Add
        </MudButton>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl Actions="ActionsPhotos">
            <Slider List="context" Context="item">
                <div style="@($"height: {(IsMobile ? "150" : "200")}px;")">
                    <MudImage Src="@item.UrlPath" Alt="@item.Caption" FallbackSrc="@ImageHelper.GetDefaultPhoto"
                              ObjectFit="ObjectFit.Cover" ObjectPosition="ObjectPosition.Center" Style="height: 100%;"></MudImage>
                    <div class="carousel-caption">
                        <MudText Typo="Typo.caption" Inline="false">
                            @item.Caption.Truncate(40)
                        </MudText>
                    </div>
                </div>
            </Slider>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Management">
    <BodyFragment>
        <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="12" sm="6">
                    <FieldGroup For="@(() => room.AvailabilityMode)" TEnum="AvailabilityMode" @bind-SelectedValue="room.AvailabilityMode"
                                CustomInfo="Whether or not room availability (status) is managed automatically by the platform (taking occupancy into account)."></FieldGroup>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FieldGroup For="@(() => room.Status)" TEnum="RoomStatus" @bind-SelectedValue="room.Status"
                                CustomInfo="Determines whether the room will be listed and available, blocked, or unavailable."></FieldGroup>
                </MudItem>
            </MudGrid>
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="6" sm="3">
                    <FieldNumber T="int" For="@(() => room.Capacity)" @bind-Value="@room.Capacity" Disabled="@(room.AccessType == AccessType.Private)"></FieldNumber>
                    <MudText Typo="Typo.caption" Color="Color.Default">
                        Available only for shared rooms
                    </MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <FieldNumber T="int?" For="@(() => room.CurrentOccupancy)" @bind-Value="@room.CurrentOccupancy" Disabled="@(room.AccessType == AccessType.Private)"></FieldNumber>
                    <MudText Typo="Typo.caption" Color="Color.Default">
                        Available only for shared rooms
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Available From" Date="@room.AvailableFrom" MinDate="DateTime.UtcNow"></MudDatePicker>
                    <MudText Typo="Typo.caption" Color="Color.Default">
                        Indicates when the room will become available. The status will change to "available" on that date.
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudStack>
    </BodyFragment>
</PageSectionComponent>

