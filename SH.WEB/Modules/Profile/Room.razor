@code
{
    [Parameter] public string? propertyId { get; set; }
    [Parameter] public string? roomId { get; set; }

    public RoomFacility? RoomFacility { get; set; }
    public AccessType RoomFacilityAccess { get; set; } = AccessType.Private;
    public string? RoomFacilityCustomName { get; set; }

    public RoomAmenity? RoomAmenity { get; set; }
    public string? RoomAmenityCustomName { get; set; }
    public RoomService? RoomService { get; set; }
    public RoomServicePrice RoomServicePrice { get; set; } = RoomServicePrice.Included;

    public string? RoomServiceCustomName { get; set; }
    public PaymentType PaymentType { get; set; } = PaymentType.Rent;
    public PaymentInterval Frequency { get; set; } = PaymentInterval.Monthly;
    public decimal? ChargeAmount { get; set; }
    public string? ChargeCustomName { get; set; }

    private bool IsMobile => AppStateStatic.Breakpoint == Breakpoint.Xs;
    private RoomModel room = new();
    public HashSet<RoomProposal> Proposals { get; set; } = [];
    public HashSet<RoomOccupation> Occupations { get; set; } = [];

    public ComponentActions<List<RoomFacilityModel>> ActionsFacilities { get; set; } = new ComponentActions<List<RoomFacilityModel>>(list => list == null || list.Empty());
    public ComponentActions<List<RoomAmenityModel>> ActionsAmenities { get; set; } = new ComponentActions<List<RoomAmenityModel>>(list => list == null || list.Empty());
    public ComponentActions<List<ServiceModel>> ActionsServices { get; set; } = new ComponentActions<List<ServiceModel>>(list => list == null || list.Empty());
    public ComponentActions<List<ChargeModel>> ActionsCharges { get; set; } = new ComponentActions<List<ChargeModel>>(list => list == null || list.Empty());

    public ComponentActions<List<RoomPhoto>> ActionsPhotos { get; set; } = new ComponentActions<List<RoomPhoto>>(list => list == null || list.Empty());

    protected override async Task LoadStaticDataAsync()
    {
        await ActionsPhotos.FinishLoading.Invoke([]);
        await ActionsFacilities.FinishLoading.Invoke(room.Facilities);
        await ActionsAmenities.FinishLoading.Invoke(room.Amenities);
        await ActionsServices.FinishLoading.Invoke(room.Services);
        await ActionsCharges.FinishLoading.Invoke(room.Costs);

        Proposals.Add(new RoomProposal { UserId = "John", Start = DateTime.UtcNow.AddDays(7), End = DateTime.UtcNow.AddYears(1), Status = ProposalStatus.Pending });
        Occupations.Add(new RoomOccupation { UserId = "John", Start = DateTime.UtcNow.AddDays(7), Status = OccupationStatus.Scheduled });
    }

    private async Task AddFacility()
    {
        if (RoomFacility.HasValue)
        {
            room.Facilities.Add(new RoomFacilityModel { Facility = RoomFacility.Value, AccessType = RoomFacilityAccess, CustomName = RoomFacilityCustomName });
            RoomFacility = null;
            RoomFacilityAccess = AccessType.Private;
            RoomFacilityCustomName = null;
        }

        await ActionsFacilities.FinishLoading.Invoke(room.Facilities);
    }

    private async Task RemoveFacility(RoomFacilityModel item)
    {
        room.Facilities.Remove(item);
        await ActionsFacilities.FinishLoading.Invoke(room.Facilities);
    }

    private async Task AddAmenity()
    {
        if (RoomAmenity.HasValue)
        {
            room.Amenities.Add(new RoomAmenityModel { Amenity = RoomAmenity.Value, CustomName = RoomAmenityCustomName });
            RoomAmenity = null;
            RoomAmenityCustomName = null;
        }
        await ActionsAmenities.FinishLoading.Invoke(room.Amenities);
    }

    private async Task RemoveAmenity(RoomAmenityModel item)
    {
        room.Amenities.Remove(item);
        await ActionsAmenities.FinishLoading.Invoke(room.Amenities);
    }

    private async Task AddService()
    {
        if (RoomService.HasValue)
        {
            room.Services.Add(new ServiceModel { Service = RoomService.Value, Price = RoomServicePrice, CustomName = RoomServiceCustomName });
            RoomService = null;
            RoomServicePrice = RoomServicePrice.Included;
            RoomServiceCustomName = null;
        }
        await ActionsServices.FinishLoading.Invoke(room.Services);
    }

    private async Task RemoveService(ServiceModel item)
    {
        room.Services.Remove(item);
        await ActionsServices.FinishLoading.Invoke(room.Services);
    }

    private async Task AddCharge()
    {
        if (ChargeAmount.HasValue)
        {
            room.Costs.Add(new ChargeModel { Type = PaymentType, Frequency = Frequency, Amount = ChargeAmount.Value, CustomName = ChargeCustomName });
            PaymentType = PaymentType.Rent;
            Frequency = PaymentInterval.Monthly;
            ChargeAmount = null;
            ChargeCustomName = null;
        }
        await ActionsCharges.FinishLoading.Invoke(room.Costs);
    }

    private async Task RemoveCharge(ChargeModel item)
    {
        room.Costs.Remove(item);
        await ActionsCharges.FinishLoading.Invoke(room.Costs);
    }

    private async Task SelectPicture()
    {
        await DialogService.SelectPicturePopup(new EventCallbackFactory().Create(this, async ((byte[], string?) result) => await PictureChanged(result.Item1, result.Item2)));
    }

    private async Task PictureChanged(byte[] buffer, string? caption)
    {
        try
        {
            var request = new PhotoRequest { Buffer = buffer };

            // _profile = await StorageApi.UploadPhoto(request, cts.Token);
            room.Photos.Add(new RoomPhoto { UrlPath = $"data:image/webp;base64,{buffer.ConvertFromBytesToBase64()}", Caption = caption });

            await ActionsPhotos.FinishLoading.Invoke(room.Photos);
        }
        catch (Exception ex)
        {
            await ProcessException(ex);
        }
    }
}
