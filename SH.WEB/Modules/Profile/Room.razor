@page "/{culture}/room/new/{propertyId}/{roomId}"
@page "/{culture}/room/edit/{propertyId}/{roomId}"

@using SH.Shared
@using SH.Shared.Requests
@using SH.WEB.Modules.Auth.Core
@inherits PageCore<Room>

@inject PrincipalApi PrincipalApi

<HeadComponent Title="@Translations.Title.Bedroom" Url="@(new Uri(Navigation.Uri).PathAndQuery)" Index="false"></HeadComponent>

<PageSectionComponent Title="@Translations.Module.Room.BasicData">
    <BodyFragment>
        <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
                        <MudGrid Spacing="@Css.SpaceSmall">
                            <MudItem xs="12">
                                <FieldGroup Name="@Translations.Module.Room.AccessType" TEnum="AccessType" @bind-SelectedValue="room.AccessType"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldText Name="@Translations.Module.Room.Title" Placeholder="@Translations.Module.Room.TitlePlaceholder" @bind-Value="@room.Title"></FieldText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <FieldNumber Name="@Translations.Module.Room.SizeSqm" @bind-Value="@room.SizeSqm"></FieldNumber>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
                        <MudGrid Spacing="@Css.SpaceSmall">
                            <MudItem xs="12">
                                <MudTabs>
                                    <MudTabPanel Text="@Translations.Module.Room.Description">
                                        <FieldText Placeholder="@Translations.Module.Room.DescriptionPlaceholder" Rows="10" @bind-Value="@room.Description"></FieldText>
                                    </MudTabPanel>
                                </MudTabs>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudStack>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="@Translations.Module.Room.Facilities" Description="@Translations.Module.Room.FacilitiesDescription">
    <ActionsFragment>
        <MudToolBar Gutters="false" WrapContent="true">
            <FieldSelect Name="@Translations.Module.Room.Facility" TEnum="RoomFacility" TValue="RoomFacility?" @bind-SelectedValue="@RoomFacility" Style="width: 200px;"
                         Filter="@((p)=>room.Facilities.All(f => f.Facility != p.Value))"></FieldSelect>
            <FieldGroup Name="@Translations.Module.Room.AccessType" TEnum="AccessType" @bind-SelectedValue="RoomFacilityAccess" CssClass="ms-2" Style="width: 300px;"></FieldGroup>
            <FieldText Name="@Translations.Module.Room.Name" @bind-Value="@RoomFacilityCustomName" CssClass="ms-2" Style="width: 200px;"
                       Visible="@(RoomFacility == SH.Shared.Enums.RoomFacility.Custom)"></FieldText>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ms-2" OnClick="AddFacility"
                       Disabled="@(!RoomFacility.HasValue)">
                @Translations.Button.Add
            </MudButton>
        </MudToolBar>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl Actions="ActionsFacilities">
            @foreach (var item in room.Facilities)
            {
                @if (item.Facility == SH.Shared.Enums.RoomFacility.Custom)
                {
                    <MudChip T="string" OnClose="() => RemoveFacility(item)" Color="Color.Primary">
                        @($"{item.CustomName} ({item.AccessType.GetFieldSettings().Name})")
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" OnClose="() => RemoveFacility(item)" Color="Color.Primary">
                        @($"{item.Facility.GetFieldSettings().Name} ({item.AccessType.GetFieldSettings().Name})")
                    </MudChip>
                }
            }
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="@Translations.Module.Room.Amenities" Description="@Translations.Module.Room.AmenitiesDescription">
    <ActionsFragment>
        <MudToolBar Gutters="false" WrapContent="true">
            <FieldSelect Name="@Translations.Module.Room.Amenity" TEnum="RoomAmenity" TValue="RoomAmenity?" @bind-SelectedValue="@RoomAmenity" Style="width: 200px;"
                         Filter="@((p)=>room.Amenities.All(a => a.Amenity != p.Value))"></FieldSelect>
            <FieldText Name="@Translations.Module.Room.Name" @bind-Value="@RoomAmenityCustomName" CssClass="ms-2" Style="width: 200px;"
                       Visible="@(RoomAmenity == SH.Shared.Enums.RoomAmenity.Custom)"></FieldText>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ms-2" OnClick="AddAmenity"
                       Disabled="@(!RoomAmenity.HasValue)">
                @Translations.Button.Add
            </MudButton>
        </MudToolBar>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl Actions="ActionsAmenities">
            @foreach (var item in room.Amenities)
            {
                @if (item.Amenity == SH.Shared.Enums.RoomAmenity.Custom)
                {
                    <MudChip T="string" OnClose="() => RemoveAmenity(item)" Color="Color.Primary">
                        @item.CustomName
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" OnClose="() => RemoveAmenity(item)" Color="Color.Primary">
                        @item.Amenity.GetFieldSettings().Name
                    </MudChip>
                }
            }
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="@Translations.Module.Room.Services" Description="@Translations.Module.Room.ServicesDescription">
    <ActionsFragment>
        <MudToolBar Gutters="false" WrapContent="true">
            <FieldSelect Name="@Translations.Module.Room.Service" TEnum="RoomService" TValue="RoomService?" @bind-SelectedValue="@RoomService" Style="width: 200px;"
                         Filter="@((p)=>room.Services.All(s => s.Service != p.Value))"></FieldSelect>
            <FieldGroup Name="@Translations.Module.Room.Price" TEnum="RoomServicePrice" @bind-SelectedValue="RoomServicePrice" CssClass="ms-2" Style="width: 250px;"></FieldGroup>
            <FieldText Name="@Translations.Module.Room.Name" @bind-Value="@RoomServiceCustomName" CssClass="ms-2" Style="width: 200px;"
                       Visible="@(RoomService == SH.Shared.Enums.RoomService.Custom)"></FieldText>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Class="ms-2" OnClick="AddService"
                       Disabled="@(!RoomService.HasValue)">
                @Translations.Button.Add
            </MudButton>
        </MudToolBar>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl Actions="ActionsServices">
            @foreach (var item in room.Services)
            {
                @if (item.Service == SH.Shared.Enums.RoomService.Custom)
                {
                    <MudChip T="string" OnClose="() => RemoveService(item)" Color="Color.Primary">
                        @($"{item.CustomName} ({item.Price.GetFieldSettings().Name})")
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" OnClose="() => RemoveService(item)" Color="Color.Primary">
                        @($"{item.Service.GetFieldSettings().Name} ({item.Price.GetFieldSettings().Name})")
                    </MudChip>
                }
            }
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="@Translations.Module.Room.Preferences">
    <BodyFragment>

        <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
                        <MudGrid Spacing="@Css.SpaceSmall">
                            <MudItem xs="12">
                                <FieldGroup Name="@Translations.Module.Room.Couples" TEnum="Allowed" @bind-SelectedValue="room.Couples"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldGroup Name="@Translations.Module.Room.Children" TEnum="Allowed" @bind-SelectedValue="room.Children"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldGroup Name="@Translations.Module.Room.Pets" TEnum="Allowed" @bind-SelectedValue="room.Pets"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldGroup Name="@Translations.Module.Room.Visits" TEnum="Allowed" @bind-SelectedValue="room.Visits"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldGroup Name="@Translations.Module.Room.Smoking" TEnum="Allowed" @bind-SelectedValue="room.Smoking"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldGroup Name="@Translations.Module.Room.Alcohol" TEnum="Allowed" @bind-SelectedValue="room.Alcohol"></FieldGroup>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
                        <MudGrid Spacing="@Css.SpaceSmall">
                            <MudItem xs="12">
                                <FieldGroup Name="@Translations.Module.Room.PreferredGenders" TEnum="Gender" SelectedValues="room.PreferredGenders" Multiple="true"
                                            CustomInfo="@Translations.Module.Room.LeaveBlank" Vertical="IsMobile"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldGroup Name="@Translations.Module.Room.PreferredOccupations" TEnum="Occupation" SelectedValues="room.PreferredOccupations" Multiple="true"
                                            CustomInfo="@Translations.Module.Room.LeaveBlank" Vertical="IsMobile"></FieldGroup>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldNumber T="int?" Name="@Translations.Module.Room.MinimumAge" @bind-Value="@room.MinimumAge"></FieldNumber>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldNumber T="int?" Name="@Translations.Module.Room.MaximumAge" @bind-Value="@room.MaximumAge"></FieldNumber>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudStack>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="@Translations.Module.Room.RentalTerms">
    <ExtraFragment>
        <MudToolBar Gutters="false" WrapContent="true">
            <FieldSelect Name="@Translations.Module.Room.Currency" TEnum="Currency" TValue="Currency" @bind-SelectedValue="@room.Currency" CssClass="me-2" Style="width: 250px;"></FieldSelect>
            <FieldNumber T="int?" Name="@Translations.Module.Room.Period" @bind-Value="@room.PeriodStay" CssClass="me-2" Style="width: 100px;"></FieldNumber>
            <FieldSelect Name="@Translations.Module.Room.Interval" TEnum="StayInterval" TValue="StayInterval" @bind-SelectedValue="@room.IntervalStay" CssClass="me-2" Style="width: 120px;"></FieldSelect>
            <FieldText Name="@Translations.Module.Room.MinimumStay" Value="@room.MinimumStay" CssClass="me-2" Style="width: 130px;" Disabled="true"></FieldText>
        </MudToolBar>
    </ExtraFragment>
    <ActionsFragment>
        <MudToolBar Gutters="false" WrapContent="true">
            <FieldSelect Name="@Translations.Module.Room.Type" TEnum="PaymentType" TValue="PaymentType" @bind-SelectedValue="@PaymentType" CssClass="me-2" Style="width: 150px;"
                         Filter="@((p)=>room.Costs.All(s => s.Type != p.Value))"></FieldSelect>
            <FieldSelect Name="@Translations.Module.Room.Interval" TEnum="PaymentInterval" TValue="PaymentInterval" @bind-SelectedValue="@Frequency" CssClass="me-2" Style="width: 220px;"></FieldSelect>
            <FieldText Name="@Translations.Module.Room.Name" @bind-Value="@ChargeCustomName" CssClass="me-2" Style="width: 130px;"
                       Visible="@(PaymentType == SH.Shared.Enums.PaymentType.Custom)"></FieldText>
            <FieldNumber T="decimal?" Name="@Translations.Module.Room.Amount" @bind-Value="@ChargeAmount" CssClass="me-2" Style="width: 100px;"></FieldNumber>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddCharge"
                       Disabled="@(!ChargeAmount.HasValue)">
                @Translations.Button.Add
            </MudButton>
        </MudToolBar>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl Actions="ActionsCharges">
            @foreach (var item in room.Costs)
            {
                @if (item.Type == SH.Shared.Enums.PaymentType.Custom)
                {
                    <MudChip T="string" OnClose="() => RemoveCharge(item)" Color="Color.Primary">
                        @($"{item.CustomName} ({item.Frequency.GetFieldSettings().Name}: {room.Currency.ToString()} {item.Amount:N2})")
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" OnClose="() => RemoveCharge(item)" Color="Color.Primary">
                        @($"{item.Type.GetFieldSettings().Name} ({item.Frequency.GetFieldSettings().Name}: {room.Currency.ToString()} {item.Amount:N2})")
                    </MudChip>
                }
            }
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="@Translations.Module.Room.Photos">
    <ActionsFragment>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SelectPicture())">
            @Translations.Button.Add
        </MudButton>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl Actions="ActionsPhotos">
            <Slider List="context" Context="item">
                <div style="@($"height: {(IsMobile ? "150" : "200")}px;")">
                    <MudImage Src="@item.UrlPath" Alt="@item.Caption" FallbackSrc="@ImageHelper.GetDefaultPhoto"
                              ObjectFit="ObjectFit.Cover" ObjectPosition="ObjectPosition.Center" Style="height: 100%;"></MudImage>
                    <div class="carousel-caption">
                        <MudText Typo="Typo.caption" Inline="false">
                            @item.Caption.Truncate(40)
                        </MudText>
                    </div>
                </div>
            </Slider>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="@Translations.Module.Room.Management">
    <BodyFragment>
        <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="12" sm="6">
                    <FieldGroup Name="@Translations.Module.Room.AvailabilityMode" TEnum="AvailabilityMode" @bind-SelectedValue="room.AvailabilityMode"
                                CustomInfo="@Translations.Module.Room.AvailabilityModeDescription"></FieldGroup>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FieldGroup Name="@Translations.Module.Room.AvailabilityStatus" TEnum="RoomStatus" @bind-SelectedValue="room.Status"
                                CustomInfo="@Translations.Module.Room.AvailabilityStatusDescription"></FieldGroup>
                </MudItem>
            </MudGrid>
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="6" sm="3">
                    <FieldNumber T="int" Name="@Translations.Module.Room.Capacity" @bind-Value="@room.Capacity" Disabled="@(room.AccessType == AccessType.Private)"></FieldNumber>
                    <MudText Typo="Typo.caption" Color="Color.Default">
                        @Translations.Module.Room.AvailableSharedRooms
                    </MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <FieldNumber T="int?" Name="@Translations.Module.Room.CurrentOccupancy" @bind-Value="@room.CurrentOccupancy" Disabled="@(room.AccessType == AccessType.Private)"></FieldNumber>
                    <MudText Typo="Typo.caption" Color="Color.Default">
                        @Translations.Module.Room.AvailableSharedRooms
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="@Translations.Module.Room.AvailableFrom" Date="@room.AvailableFrom" MinDate="DateTime.UtcNow"></MudDatePicker>
                    <MudText Typo="Typo.caption" Color="Color.Default">
                        @Translations.Module.Room.AvailableFromDescription
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudStack>
    </BodyFragment>
</PageSectionComponent>

