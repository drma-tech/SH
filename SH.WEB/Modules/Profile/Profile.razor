@page "/{culture}/account/profile"

@inherits PageCore<Profile>

<PageSectionComponent Title="Basic Data">
    <BodyFragment>
        <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="12" sm="4">
                    <FieldText Name="@Translations.Module.Profile.FirstName" @bind-Value="@profile.FirstName"></FieldText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <FieldText Name="@Translations.Module.Profile.LastName" @bind-Value="@profile.LastName"></FieldText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <FieldSelect Name="@Translations.Module.Profile.Nationality" TEnum="Country" TValue="Country?" SelectedValue="profile.Nationality"></FieldSelect>
                </MudItem>
            </MudGrid>
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="12" sm="4">
                    <FieldNumber Name="@Translations.Module.Profile.Age" Rows="6" @bind-Value="@profile.Age"></FieldNumber>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <FieldSelect Name="@Translations.Module.Profile.Gender" TEnum="Gender" TValue="Gender?" SelectedValue="profile.Gender"></FieldSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <FieldSelect Name="@Translations.Module.Profile.Occupation" TEnum="Occupation" TValue="Occupation?" SelectedValue="profile.Occupation"></FieldSelect>
                </MudItem>
            </MudGrid>
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="12" sm="4">
                    <FieldSelect Name="@Translations.Module.Profile.HomeSchedule" TEnum="HomeSchedule" TValue="HomeSchedule?" SelectedValue="profile.HomeSchedule"></FieldSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <FieldSelect Name="@Translations.Module.Profile.Languages" TEnum="Language" TValue="HashSet<Language>"
                                 SelectedValue="profile.Languages" Multiple="true" ShowDataSelectDescription="false"></FieldSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <FieldText Name="@Translations.Module.Profile.ProfilePicture" @bind-Value="@profile.ProfilePicture"></FieldText>
                </MudItem>
            </MudGrid>
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="12">
                    <FieldText Name="@Translations.Module.Profile.AboutMe" @bind-Value="profile.AboutMe" Rows="8"></FieldText>
                </MudItem>
            </MudGrid>
        </MudStack>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Household Profile">
    <BodyFragment>
        <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="6" sm="4" Style="padding-top: 4px;">
                    <FieldSwitch Name="@Translations.Module.Profile.Smokes" @bind-Value="@profile.Smokes"></FieldSwitch>
                </MudItem>
                <MudItem xs="6" sm="4" Style="padding-top: 4px;">
                    <FieldSwitch Name="@Translations.Module.Profile.DrinksAlcohol" @bind-Value="@profile.DrinksAlcohol"></FieldSwitch>
                </MudItem>
                <MudItem xs="6" sm="4" Style="padding-top: 4px;">
                    <FieldSwitch Name="@Translations.Module.Profile.LivesWithPets" @bind-Value="@profile.LivesWithPets"></FieldSwitch>
                </MudItem>
            </MudGrid>
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="6" sm="4" Style="padding-top: 4px;">
                    <FieldSwitch Name="@Translations.Module.Profile.LivesWithChildren" @bind-Value="@profile.LivesWithChildren"></FieldSwitch>
                </MudItem>
                <MudItem xs="6" sm="4" Style="padding-top: 4px;">
                    <FieldSwitch Name="@Translations.Module.Profile.LivesAsCouple" @bind-Value="@profile.LivesAsCouple"></FieldSwitch>
                </MudItem>
                <MudItem xs="6" sm="4" Style="padding-top: 4px;">
                    <FieldSwitch Name="@Translations.Module.Profile.HostsVisitors" @bind-Value="@profile.HostsVisitors"></FieldSwitch>
                </MudItem>
            </MudGrid>
        </MudStack>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Social Media">
    <BodyFragment>
        <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="12" sm="6">
                    <FieldText CssIcon="@Icons.Custom.Brands.Instagram" Name="@Translations.Module.Profile.Instagram" @bind-Value="@profile.Instagram"></FieldText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FieldText CssIcon="@Icons.Custom.Brands.LinkedIn" Name="@Translations.Module.Profile.LinkedIn" @bind-Value="@profile.LinkedIn"></FieldText>
                </MudItem>
            </MudGrid>
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="12" sm="6">
                    <FieldText CssIcon="@Icons.Custom.Brands.Facebook" Name="@Translations.Module.Profile.Facebook" @bind-Value="@profile.Facebook"></FieldText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FieldText CssIcon="@Icons.Material.Filled.Web" Name="@Translations.Module.Profile.OtherSocialMedia" @bind-Value="@profile.OtherSocialMedia"></FieldText>
                </MudItem>
            </MudGrid>
        </MudStack>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Verifications">
    <BodyFragment>
        <MudStack Spacing="3" Breakpoint="Breakpoint.Xs">
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="6" sm="4" md="3" xl="2" Style="padding-top: 4px;">
                    <ItemData Name="@Translations.Module.Profile.IdVerified" Value="@profile.IdVerified"></ItemData>
                </MudItem>
                <MudItem xs="6" sm="4" md="3" xl="2" Style="padding-top: 4px;">
                    <ItemData Name="@Translations.Module.Profile.EmailVerified" Value="@profile.EmailVerified"></ItemData>
                </MudItem>
                <MudItem xs="6" sm="4" md="3" xl="2" Style="padding-top: 4px;">
                    <ItemData Name="@Translations.Module.Profile.PhoneVerified" Value="@profile.PhoneVerified"></ItemData>
                </MudItem>
            </MudGrid>
        </MudStack>
    </BodyFragment>
</PageSectionComponent>

<FloatingButton Template="Template.Back"></FloatingButton>

@code {
    private ProfileModel profile = new(AppStateStatic.UserId);
}
