@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inherits BaseComponentCore<SelectPicturePopup>

<MudDialog Style="width: 100%; max-height: 100vh;">
    <DialogContent>
        <MudFileUpload T="IBrowserFile" Accept="image/*" FilesChanged="OnFileSelected" MaximumFileCount="1">
            <CustomContent>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload" OnClick="@context.OpenFilePickerAsync">
                    @Translations.Button.SelectPhoto
                </MudButton>
            </CustomContent>
        </MudFileUpload>
        @if (imageLoaded)
        {
            <div class="mt-2" style="text-align: center;">
                <img src="@imageUrl" style="max-height: calc(100vh - 400px); max-width: 100%; object-fit: contain;" />
            </div>
        }
        <MudTextField Label="Caption" Class="mt-3" @bind-Value="caption" Placeholder="Describe what is shown in this photo (optional)"></MudTextField>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@SavePictureHandle" Variant="Variant.Filled" Size="AppStateStatic.Size" Disabled="!imageLoaded">
            @Translations.Button.Ok
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .mud-file-upload-files {
        display: none;
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public EventCallback<(byte[], string?)> PictureChanged { get; set; }

    const long maxAllowedSize = 10 * 1024 * 1024; // 10 MB
    private bool imageLoaded = false;
    private string? imageUrl;
    private byte[]? buffer;
    private string? caption;

    private async Task OnFileSelected(IBrowserFile? file)
    {
        try
        {
            if (file == null) return;

            await using var stream = file.OpenReadStream(maxAllowedSize, cts.Token);
            using var streamRef = new DotNetStreamReference(stream);

            buffer = await JsRuntime.Utils().ResizeImage(streamRef, 1600, cts.Token);

            var base64 = Convert.ToBase64String(buffer);

            imageUrl = $"data:image/webp;base64,{base64}";

            imageLoaded = true;
        }
        catch (IOException)
        {
            await ShowWarning($"The image file size is too large. Maximum allowed size is {maxAllowedSize / 1024 / 1024} MB.");
        }
        catch (Exception ex)
        {
            await ProcessException(ex);
        }
    }

    private async Task SavePictureHandle()
    {
        await PictureChanged.InvokeAsync((buffer!, caption));

        MudDialog?.Close();
    }
}