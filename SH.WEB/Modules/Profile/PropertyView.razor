@page "/{culture}/property/view/{propertyId}"

@using SH.WEB.Modules.Profile.Core
@using TranslationProperty = SH.Shared.Translations.Model.Property;
@inherits PageParameterCore<PropertyView>

@inject PrincipalApi PrincipalApi
@inject MapApi MapApi
@inject PropertyPublicApi PropertyPublicApi
@inject RoomApi RoomApi

<HeadComponent Title="@Title" Url="@(new Uri(Navigation.Uri).PathAndQuery)" Index="false"></HeadComponent>

<PageSectionComponent Title="@Title" IsPageHeader="true" Image="@PhotoUrl">
    <ExtraFragment>
        <RenderControl State="PropertyState" Context="property">
            <MudGrid Spacing="@CssHelper.SpaceSmall">
                <MudItem xs="6" sm="4" md="3" xl="2">
                    <CustomChip Name="@TranslationProperty.Structure" Value="@property.Structure.GetFieldSettings().Name"></CustomChip>
                </MudItem>
                <MudItem xs="6" sm="4" md="3" xl="2">
                    <CustomChip Name="@TranslationProperty.SharedWith" Value="@property.SharedWith.GetFieldSettings().Name"></CustomChip>
                </MudItem>
                <MudItem xs="6" sm="4" md="3" xl="2">
                    <CustomChip Name="@TranslationProperty.AddressVerified" Value="@property.AddressVerified"></CustomChip>
                </MudItem>
            </MudGrid>
        </RenderControl>
    </ExtraFragment>
    <ActionsFragment>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="me-2">
            Action 1
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="me-2">
            Action 2
        </MudButton>
    </ActionsFragment>
</PageSectionComponent>

<PageSectionComponent Title="About" Color="Color.Secondary">
    <BodyFragment>
        <RenderControl State="PropertyState" Context="property">
            <MudGrid Spacing="@CssHelper.SpaceSmall">
                <MudItem xs="12" md="6">
                    <MudCard>
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Color="Color.Tertiary">
                                Description:
                            </MudText>
                            <MudText Typo="Typo.body1">
                                @(property?.Description ?? "no description")
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCard>
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Color="Color.Tertiary">
                                Location Description:
                            </MudText>
                            <MudText Typo="Typo.body1">
                                @(property?.LocationDesc ?? "no location description")
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Details" Color="Color.Secondary">
    <BodyFragment>
        <RenderControl State="PropertyState" Context="property">
            <MudGrid Spacing="@CssHelper.SpaceSmall">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6" Color="Color.Tertiary">
                        @TranslationProperty.Facilities
                    </MudText>
                    <CustomEnumChips Values="@property.Facilities.AsField()"></CustomEnumChips>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6" Color="Color.Tertiary">
                        @TranslationProperty.Amenities
                    </MudText>
                    <CustomEnumChips Values="@property.Amenities.AsField()"></CustomEnumChips>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6" Color="Color.Tertiary">
                        @TranslationProperty.Accessibilities
                    </MudText>
                    <CustomEnumChips Values="@property.Accessibilities.AsField()"></CustomEnumChips>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6" Color="Color.Tertiary">
                        @TranslationProperty.Languages
                    </MudText>
                    <CustomEnumChips Values="@property.Languages.AsField()"></CustomEnumChips>
                </MudItem>
            </MudGrid>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="@TranslationProperty.Requirements" Color="Color.Secondary" Description="Requirements to apply as a tenant for this property">
    <BodyFragment>
        <RenderControl State="PropertyState" Context="property">
            <MudGrid Spacing="@CssHelper.SpaceSmall">
                <MudItem xs="12" sm="6" md="3">
                    <CustomChip Name="@TranslationProperty.SocialRequired" Value="@property.SocialRequired"></CustomChip>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <CustomChip Name="@TranslationProperty.IdVerificationRequired" Value="@property.IdVerificationRequired"></CustomChip>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <CustomChip Name="@TranslationProperty.IncomeVerificationRequired" Value="@property.IncomeVerificationRequired"></CustomChip>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <CustomChip Name="@TranslationProperty.BackgroundCheckRequired" Value="@property.BackgroundCheckRequired"></CustomChip>
                </MudItem>
            </MudGrid>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="@TranslationProperty.Photos" Color="Color.Secondary">
    <BodyFragment>
        <RenderControl State="PropertyState" Context="property">
            <Slider List="property.Photos" Context="item">
                <div style="@($"height: {(AppStateStatic.IsMobile ? "150" : "200")}px;")">
                    <MudImage Src="@item.PhotoUrl" Alt="@item.Caption" FallbackSrc="@ImageHelper.GetDefaultPhoto"
                              ObjectFit="ObjectFit.Cover" ObjectPosition="ObjectPosition.Center" Style="height: 100%;"></MudImage>
                    <div class="carousel-caption">
                        <MudText Typo="Typo.caption" Inline="false">
                            @item.Caption.Truncate(40)
                        </MudText>
                    </div>
                </div>
            </Slider>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="@TranslationProperty.Rooms" Color="Color.Secondary">
    <BodyFragment>
        <RenderControl State="PropertyState" Context="property">
            <Slider List="@property.Rooms" Context="room">
                <div style="@($"width: {(AppStateStatic.IsMobile ? "200" : "250")}px;")">
                    <div style="position: relative;">
                        <MudCard Outlined="true">
                            <MudCardMedia Image="@(room.PhotoUrl ?? "images/no-image.webp")" Height="150" />
                            <MudCardHeader Style="text-align: initial;" Class="pa-2">
                                <CardHeaderContent>
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">@room?.Title</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                        </MudCard>
                    </div>
                </div>
            </Slider>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="Reviews" Color="Color.Secondary">
    <BodyFragment>
        <RenderControl State="ReviewsState" Context="reviews">
            <Slider List="@reviews" Context="review">
                @review
            </Slider>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<FloatingButton Template="Template.Back"></FloatingButton>