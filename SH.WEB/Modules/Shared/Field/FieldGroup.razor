@inherits FormBase
@typeparam TEnum where TEnum : struct, Enum, IConvertible

@if (Visible)
{
    <div class="@CssClass" style="align-items: center; @Style">
        @if (CssIcon.NotEmpty())
        {
            <MudIcon Icon="@CssIcon" Class="me-3"></MudIcon>
        }
        @* <p class="mud-input-label" style="transform: scale(0.75);margin-bottom: -7px;">Tipo de acesso</p> *@
        <MudText Typo="Typo.caption">
            @Name
        </MudText>
        @if (Multiple)
        {
            <MudToggleGroup T="TEnum" Values="@SelectedValues" ValuesChanged="@SelectedValuesChanged" Vertical="@Vertical" FixedContent="Vertical"
                            Disabled="@Disabled" Style="width: 100%;" SelectionMode="@(Multiple ? SelectionMode.MultiSelection : SelectionMode.SingleSelection)" CheckMark="true">
                @foreach (var item in EnumList.Where(Filter).OrderBy(Order))
                {
                    <MudToggleItem Value="@item" Text="@item.GetFieldSettings()?.Name"
                                   UnselectedIcon="@Icons.Material.Filled.CheckBoxOutlineBlank" SelectedIcon="@Icons.Material.Filled.CheckBox" />
                }
            </MudToggleGroup>
        }
        else
        {
            <MudToggleGroup T="TEnum" Value="@SelectedValue" ValueChanged="@SelectedValueChanged" Vertical="@Vertical" FixedContent="Vertical"
                            Disabled="@Disabled" Style="width: 100%;" SelectionMode="@(Multiple ? SelectionMode.MultiSelection : SelectionMode.SingleSelection)" CheckMark="true">
                @foreach (var item in EnumList.Where(Filter).OrderBy(Order))
                {
                    <MudToggleItem Value="@item" Text="@item.GetFieldSettings()?.Name" />
                }
            </MudToggleGroup>
        }
    </div>
    @if (!string.IsNullOrEmpty(HelpLink))
    {
        <MudText Typo="Typo.caption" Style="margin-left: calc(1.5rem + 14px)">
            <MudLink href="@HelpLink" target="_blank" rel="nofollow" Typo="Typo.caption">@(new Uri(HelpLink).Host)</MudLink>
        </MudText>
    }
    @if (!string.IsNullOrEmpty(CustomInfo))
    {
        <MudText Typo="Typo.caption" Color="Color.Default" Style="@(CssIcon.NotEmpty() ? "margin-left: calc(1.5rem + 14px)" : "")">
            @CustomInfo
        </MudText>
    }
    @if (!string.IsNullOrEmpty(CustomWarning))
    {
        <MudText Typo="Typo.caption" Color="Color.Warning" Style="@(CssIcon.NotEmpty() ? "margin-left: calc(1.5rem + 14px)" : "")">
            @CustomWarning
        </MudText>
    }
}

@code {
    [Parameter] public bool Multiple { get; set; } = false;
    [Parameter] public bool Vertical { get; set; } = false;
}