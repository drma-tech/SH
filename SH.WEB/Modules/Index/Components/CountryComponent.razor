@using SH.Shared.Models.Index
@using SH.WEB.Modules.Index.Core

@inherits ComponentCore<CountryComponent>

@inject IndexApi IndexApi

<MudChipSet T="CountryIndexItem" SelectedValue="@Value" SelectedValueChanged="ValueChanged" CheckMark="true" SelectionMode="@SelectionMode.SingleSelection">
    @foreach (var item in CountryIndex?.Countries ?? new HashSet<CountryIndexItem>())
    {
        <MudChip T="CountryIndexItem" Size="AppStateStatic.Size" Value="@item" Variant="Variant.Outlined">
            @item.CountryName
        </MudChip>
    }
</MudChipSet>

@code {
    public CountryIndex? CountryIndex { get; set; }

    [Parameter] public CountryIndexItem? Value { get; set; }
    [Parameter] public EventCallback<CountryIndexItem?> ValueChanged { get; set; }

    protected override async Task LoadStaticDataAsync()
    {
        CountryIndex = await IndexApi.GetCountry(null, Cts.Token);
    }
}
