@using SH.Shared.Models.Index

@inherits ComponentParameterCore<StateComponent>

@inject IndexStateApi IndexStateApi

<RenderControl T="StateIndex" State="Actions" Context="ctx" LoadingHeight="40px">
    <MudChipSet T="StateIndexItem" SelectedValue="@Value" SelectedValueChanged="ValueChanged" CheckMark="true" SelectionMode="@SelectionMode.SingleSelection">
        @foreach (var item in ctx.States ?? new HashSet<StateIndexItem>())
        {
            <MudChip T="StateIndexItem" Size="AppStateStatic.Size" Value="@item" Variant="Variant.Outlined">
                @item.StateName
            </MudChip>
        }
    </MudChipSet>
</RenderControl>

@code {
    [Parameter] public CountryIndexItem? Country { get; set; }

    [Parameter] public StateIndexItem? Value { get; set; }
    [Parameter] public EventCallback<StateIndexItem?> ValueChanged { get; set; }

    private RenderControlState<StateIndex?> Actions { get; set; } = new RenderControlState<StateIndex?>(null, obj => obj == null || obj.States.Empty());

    protected override async Task LoadStaticDataAsync()
    {
        await Actions.StartLoading.Invoke("Select a country");
    }

    protected override IReadOnlyList<string> GetParameterKey()
    {
        return [Country?.CountryCode ?? ""];
    }

    protected override async Task LoadParameterDataAsync()
    {
        await IndexStateApi.GetState(Country?.CountryCode, [Actions], Cts.Token);
        Value?.StateCode = null;
        Value?.StateName = null;
        await ValueChanged.InvokeAsync(Value);
    }
}
